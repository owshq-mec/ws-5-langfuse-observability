# --- Models -------------------------------------------------------------
# Anthropic key used by Graphiti ingestion and by the Claude Agent SDK.
ANTHROPIC_API_KEY=
HELIX_AGENT_MODEL=claude-opus-5-5
HELIX_INGEST_MODEL=claude-haiku-5-5

# Optional: route the agent through OpenRouter instead of Anthropic.
# HELIX_AGENT_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# --- Helix context engine ---------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=helix-dev-password
HELIX_GROUP_ID=orbisa
HELIX_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
SEMAPHORE_LIMIT=4
HELIX_MCP_HOST=127.0.0.1
HELIX_MCP_PORT=8765

# --- Langfuse v4, self-hosted in Docker (infra/docker-compose.yml) -----
# Empty values below are generated by: uv run python scripts/init_env.py
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=engineer@orbisa.example
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_TRACING_ENVIRONMENT=workshop

# Langfuse infrastructure secrets (generated, local only)
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
