        },
        {
          "speakerId": "6432345678555530301",
          "topic": "Product",
          "sentences": [
            {
              "start": 17300,
              "end": 29900,
              "text": "Orbisa Track pulls all carrier events into one API and dashboard, so you get one ETA per shipment."
