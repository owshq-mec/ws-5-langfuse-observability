      "transcript": [
        {
          "speakerId": "6432345678555530302",
          "topic": "Discovery",
          "sentences": [
            {
              "start": 5200,
              "end": 16800,
              "text": "We run about two hundred trucks and today our ETAs come from four different carrier portals."
